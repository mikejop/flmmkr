# Supabase Public & Server Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Database Connection Strings
DATABASE_URL="postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Asaas Payment API
# Produção: https://api.asaas.com/v3   |   Sandbox (use em todo teste): https://api-sandbox.asaas.com/v3
ASAAS_API_URL="https://api.asaas.com/v3"

# Asaas, webhook e Resend credentials are stored in Supabase Vault.
# Required Vault names: asaas_api_key, asaas_webhook_secret, resend_api_key.

# Segredo (HMAC) para guardar o IP do cronômetro da oferta só como hash. Gere com: openssl rand -hex 32
IP_HASH_SALT=

# Webhook do Asaas: token opcional por variável. Se não existir, usa o segredo asaas_webhook_secret do Supabase Vault (o que já está em uso).
ASAAS_WEBHOOK_TOKEN=

# Panda Video: DRM com marca d'água (grupo DRM > Settings > API). Sem elas o player funciona sem marca d'água.
PANDA_DRM_GROUP_ID=
PANDA_DRM_SECRET=

# Segredo (qualquer string longa e aleatória) para o rate limit por usuário/IP. Só no servidor.
RATE_LIMIT_HMAC_SECRET=

# Cloudflare Turnstile (checkout). A chave pública vai no navegador; a secreta SÓ no servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (REST): cache de acesso/tokens e rate limit. Só no servidor. Sem ele, o rate limit usa o Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Segredo para POST /api/revalidate (invalidação de cache por tag). Só no servidor.
REVALIDATE_SECRET=

# Conexão direta ao Postgres (só se alguma função usar conexão direta): use o pooler Supavisor, porta 6543, modo transaction.
# Exemplo: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_URL=

# Minha Conta: alertas operacionais (reembolso que falhou, revisão manual) vão para este e-mail.
ADMIN_ALERT_EMAIL=
# Segredo do Vercel Cron que executa as exclusões de conta agendadas (GET /api/cron/delete-accounts, header Authorization: Bearer).
CRON_SECRET=
# Sal do hash de CPF usado no limite de 1 reembolso por CPF e produto (se vazio usa RATE_LIMIT_HMAC_SECRET).
CPF_HASH_SALT=

# Honeypot: IPs que NUNCA são bloqueados (o seu, de quem testa). Separe por vírgula. Aceita IPv4, IPv6 e IPv6 com /64
# (o endereço IPv6 do seu computador muda a cada tantas horas; o prefixo /64 cobre a sua rede). Ex.: 203.0.113.7,2001:db8:1:2::/64
HONEYPOT_ALLOWLIST_IPS=

# Cloudflare R2 (armazenamento S3-compatível, bucket PRIVADO). Só servidor. Crie um token R2 restrito ao bucket (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flmmkr-members
