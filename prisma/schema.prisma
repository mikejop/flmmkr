generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id              String   @id @db.Uuid
  email           String
  fullName        String   @map("full_name")
  phone           String?
  birthDate       String?  @map("birth_date")
  age             Int?
  profession      String?
  address         Json?
  asaasCustomerId String?  @map("asaas_customer_id")
  asaasPaymentId  String?  @map("asaas_payment_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("profiles")
}

model CheckoutAbandonmentLead {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName      String   @map("full_name")
  email         String?
  phone         String?
  location      String?
  profession    String?
  status        String
  paymentMethod String?  @map("payment_method")
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("checkout_abandonment_leads")
}

model PendingCheckout {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String   @unique @map("payment_id")
  asaasCustomerId String?  @map("asaas_customer_id")
  fullName        String   @map("full_name")
  email           String
  phone           String?
  birthDate       String?  @map("birth_date")
  age             Int?
  profession      String?
  address         Json?
  amount          Decimal? @db.Decimal(10, 2)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("pending_checkouts")
}

model OfferTimerSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  macAddress       String   @map("mac_address")
  ip               String
  clientIdentifier String   @unique @map("client_identifier")
  userAgent        String?  @map("user_agent")
  firstAccessAt    DateTime @default(now()) @map("first_access_at") @db.Timestamptz
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  cooldownUntil    DateTime @map("cooldown_until") @db.Timestamptz
  isExpired        Boolean  @default(false) @map("is_expired")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([macAddress])
  @@index([ip])
  @@index([clientIdentifier])
  @@map("offer_timer_sessions")
}
